{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "maya": {
      "type": "local",
      "command": ["python3", "/ABSOLUTE/PATH/TO/maya-bridge/mcp_server.py"],
      "environment": {
        "MAYA_BRIDGE_PORT": "7789"
      },
      "timeout": 300000,
      "enabled": true
    }
  },
  "experimental": {
    "mcp_timeout": 300000
  }
}
